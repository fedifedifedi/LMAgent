# Copier les lignes utiles dans .env.local (jamais commité). Aucune vraie valeur ici.
# En déploiement (Railway), définir ces variables dans l'onglet Variables du service.

# ── IA ──────────────────────────────────────────────────────────────────────────
# mock (défaut, sans clé ni réseau : tests, démo locale) | cominty (agent managé Cominty, recommandé)
# anthropic | gemini : anciens providers, retirés à l'étape 6.
LLM_PROVIDER=mock

# Agent managé Cominty (obligatoires si LLM_PROVIDER=cominty) — platform.cominty.ai
# Clé : platform.cominty.ai/api-keys · Utilisateur : avatar → Profile (forme user_…) · Agent : platform.cominty.ai/agents
COMINTY_API_KEY=
COMINTY_USER_ID=
COMINTY_AGENT_ID=
# Facultatif : défaut https://ds.cominty.com
# COMINTY_BASE_URL=

# Anciens providers (inutiles avec Cominty)
LLM_MODEL=
LLM_MODEL_FAST=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Base de données ────────────────────────────────────────────────────────────
# SQLite via libSQL. Local : défaut file:./prisma/dev.db
# Railway : volume monté sur /data → file:/data/lmagent.db (valeur par défaut de l'image Docker)
# DATABASE_URL=

# ── Export PDF ──────────────────────────────────────────────────────────────────
# Chemin de Chrome / Edge / Chromium.
# Windows : C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Image Docker (Railway) : /usr/bin/chromium (déjà défini dans le Dockerfile)
# CHROME_PATH=
# 1 dans un conteneur Linux (Chromium sans bac à sable) — déjà défini dans le Dockerfile
# CHROME_NO_SANDBOX=
# Adresse locale de la page d'impression, {PORT} remplacé par le port — déjà défini dans le Dockerfile
# PDF_RENDER_ORIGIN=http://127.0.0.1:{PORT}

# ── Démo ────────────────────────────────────────────────────────────────────────
# 0 pour masquer le bouton « Essayer avec un profil de démo » de l'accueil (affiché par défaut).
# DEMO_ENABLED=
