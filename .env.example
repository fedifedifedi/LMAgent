# Copier les lignes utiles dans .env.local (jamais commité).

# Provider LLM : mock (défaut, sans clé) | anthropic | gemini
LLM_PROVIDER=mock
# Obligatoire hors mock : identifiant exact du modèle chez le provider choisi (aucun défaut dans le code).
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Base SQLite (défaut : file:./prisma/dev.db)
# DATABASE_URL=

# Étape 10 (export PDF)
# CHROME_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
