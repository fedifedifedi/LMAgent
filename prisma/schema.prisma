// Contraintes et index ajoutés en SQL brut dans les migrations (Prisma ne les modélise pas) :
// - triggers document_owner_* : un Document appartient soit à un Profile, soit à une Letter (COMPANY_PAGE => Letter).
// - table virtuelle chunk_fts (FTS5) + triggers chunk_* qui la synchronisent avec Chunk.
// Une migration qui recrée Document ou Chunk (redéfinition de table SQLite) supprime ces triggers : les recréer.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id        String     @id @default(cuid())
  name      String
  /// Profil validé par ProfileSchema (lib/schemas/profile.ts) à l'écriture et à la lecture.
  data      Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  letters   Letter[]
  documents Document[]
  cvImports CvImport[]
}

enum CvSource {
  PDF
  IMAGE
  TEXT
}

/// TEXT : le modèle reçoit le texte extrait ou collé. NATIVE : il lit le fichier lui-même (image, PDF scanné).
enum CvReadMode {
  TEXT
  NATIVE
}

/// Import d'un CV : texte extrait et brouillon LLM, conservés jusqu'à la validation du profil (étape 6).
model CvImport {
  id         String     @id @default(cuid())
  source     CvSource
  readMode   CvReadMode @default(TEXT)
  /// Nom du fichier téléversé.
  sourceName String?
  /// Texte du CV après extraction et normalisation ; null en lecture native.
  text       String?
  /// Brouillon validé par ProfileDraftSchema.
  draft      Json
  /// true si seul le schéma tolérant a pu récupérer la sortie du LLM ; issues contient alors les erreurs.
  degraded   Boolean
  issues     String?
  /// LLMUsage de l'extraction (provider, modèle, tokens, tentatives).
  usage      Json
  /// Profil créé à partir de cet import, une fois validé.
  profileId  String?
  profile    Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([profileId])
}

/// DRAFT : pipeline en cours (l'étape suivante se déduit des champs remplis). FAILED : erreur (error), reprenable.
/// FINAL est conservé pour compatibilité (non utilisé).
enum LetterStatus {
  DRAFT
  /// L'agent Cominty attend les réponses du candidat (questions de AgentRun.questions).
  NEEDS_INPUT
  GENERATED
  FAILED
  FINAL
}

model Letter {
  id        String       @id @default(cuid())
  profileId String
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  offerText String
  offerUrl  String?
  /// "fr" ou "en", déterminée par analyzeOffer.
  language  String?
  /// Sortie d'analyzeOffer (OfferAnalysisSchema).
  analysis  Json?
  /// Sortie de matchProfile.
  match     Json?
  /// Première version de writeLetter.
  draft     Json?
  /// Sortie de critique (avis du modèle).
  critique  Json?
  /// Lettre finale (brouillon validé, ou réécriture), avec les retouches de l'utilisateur (phrases edited).
  content   Json?
  /// Version produite par l'agent, avant retouches (pour « Revenir à la version générée »).
  generated Json?
  /// Template de mise en page (lib/letters/templates.ts) : classique, moderne ou compact.
  template  String       @default("moderne")
  /// Problèmes détectés par le code (longueur, compétences absentes revendiquées...) restant sur la lettre finale.
  checks    Json?
  /// Sortie de l'agent Cominty hors lettre : { score, scoreReasons, cvAdjustments } (lib/agent/agent-reply.ts).
  insights  Json?
  status    LetterStatus @default(DRAFT)
  /// Dernière erreur (étape en échec), effacée à la reprise.
  error     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  documents Document[]
  llmCalls  LlmCall[]
  agentRuns AgentRun[]

  @@index([profileId])
}

enum LlmStep {
  ANALYZE_OFFER
  MATCH_PROFILE
  WRITE_LETTER
  CRITIQUE
  REWRITE
  PROFILE_SUMMARY
  /// Un tour de l'agent Cominty sur la lettre (démarrage, réponse aux questions ou correction).
  AGENT_LETTER
}

/// Un appel generateObject (toutes tentatives cumulées) : suivi des tokens par lettre et par étape.
model LlmCall {
  id              String   @id @default(cuid())
  letterId        String?
  letter          Letter?  @relation(fields: [letterId], references: [id], onDelete: Cascade)
  /// Pour les appels hors lettre (résumé du profil).
  profileId       String?
  step            LlmStep
  provider        String
  model           String
  inputTokens     Int
  outputTokens    Int
  cacheReadTokens Int?
  attempts        Int
  durationMs      Int
  estimated       Boolean  @default(false)
  /// Coût facturé en dollars, quand le provider le donne (Cominty).
  costUsd         Float?
  success         Boolean
  error           String?
  createdAt       DateTime @default(now())

  @@index([letterId])
}

/// Dépense réelle chez Cominty : une ligne par message facturé (événement result), quelle que soit la fonction
/// (lettre, import du CV, résumé, correction, échec). Sa somme est comparée au plafond COMINTY_BUDGET_USD.
model ComintyCharge {
  messageId    String   @id
  costUsd      Float
  inputTokens  Int
  outputTokens Int
  createdAt    DateTime @default(now())
}

enum AgentRunKind {
  /// Premier message : profil, sources autorisées et offre.
  START
  /// Réponses du candidat aux questions de l'agent.
  ANSWER
  /// Relance automatique quand le JSON de l'agent ne respecte pas le schéma (une seule par lettre).
  CORRECTION
}

enum AgentRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

/// Un message de l'agent Cominty pour une lettre : suivi en direct, reprenable (lastEventId) après une coupure.
model AgentRun {
  id          String         @id @default(cuid())
  letterId    String
  letter      Letter         @relation(fields: [letterId], references: [id], onDelete: Cascade)
  threadId    String
  messageId   String         @unique
  kind        AgentRunKind
  status      AgentRunStatus @default(RUNNING)
  /// Questions natives de Cominty ({ prompt, options }[]) quand l'agent attend une réponse.
  questions   Json?
  /// Dernier événement reçu : reprise du flux sans relancer l'agent.
  lastEventId String?
  error       String?
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?
  events      AgentEvent[]

  @@index([letterId])
}

/// Événement du flux Cominty, conservé pour réafficher les étapes de l'agent après un rechargement.
model AgentEvent {
  id            String   @id @default(cuid())
  runId         String
  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Id de l'événement chez Cominty (unique par run).
  eventId       String
  /// Les phases running / success d'une même étape partagent ce numéro.
  correlationId Int
  name          String
  status        String
  /// Libellé lisible affiché dans l'interface.
  label         String
  at            DateTime

  @@unique([runId, eventId])
  @@index([runId])
}

enum DocumentKind {
  PROJECT
  INTERNSHIP_REPORT
  RECOMMENDATION
  PAST_LETTER
  COMPANY_PAGE
}

model Document {
  id         String       @id @default(cuid())
  kind       DocumentKind
  title      String
  sourceName String?
  content    String
  profileId  String?
  profile    Profile?     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  letterId   String?
  letter     Letter?      @relation(fields: [letterId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  chunks     Chunk[]

  @@index([profileId])
  @@index([letterId])
}

/// id entier = rowid SQLite, utilisé par chunk_fts (FTS5) et plus tard par vector_top_k (libSQL).
model Chunk {
  id         Int      @id @default(autoincrement())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int
  text       String

  @@unique([documentId, index])
}
